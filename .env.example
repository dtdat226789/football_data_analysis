# Upstream Football Charts API key. The free tier returns the current and
# previous season only; older seasons must already be in data/raw/.
FOOTBALL_CHARTS_API_KEY=

# PostgreSQL DSN for the football database.
DATABASE_URL=

# Optional. Seconds between upstream requests in fetch_fixtures.py. Raise to be
# gentler on the feed.
FETCH_DELAY_SECONDS=

# Production API hardening. Set both values in the Render environment.
# The Worker receives BACKEND_SHARED_SECRET via `wrangler secret put` and sends
# it as X-Worker-Secret; the API rejects direct origin requests without it.
WORKER_SHARED_SECRET=

# Backend fallback limit (optional). The Worker enforces 120 requests/minute
# per client IP for /api/* (see wrangler.jsonc); set this as a second line of
# defence when the Render origin is reachable directly.
API_RATE_LIMIT_PER_MINUTE=

# Set to 1 in production to disable /docs, /redoc and /openapi.json.
DISABLE_DOCS=
